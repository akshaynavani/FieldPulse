{
  "name": "@fieldpulse/hooks",
  "version": "0.1.0",
  "private": true,
  "description": "React Query hooks shared by the FieldPulse mobile and web apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"hooks are exercised through the apps\""
  },
  "dependencies": {
    "@fieldpulse/api-client": "*",
    "@fieldpulse/contracts": "*",
    "@fieldpulse/core": "*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@types/react": "~18.2.79",
    "react": "18.2.0"
  }
}
