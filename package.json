{
  "name": "fieldpulse",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform field sales tool — React Native + web in a Turborepo monorepo",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "db:migrate": "npm run migrate --workspace @fieldpulse/api",
    "db:seed": "npm run seed --workspace @fieldpulse/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
